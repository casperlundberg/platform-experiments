          "intent": {
            "mode": "off"
          }
        },
        {
          "label": "decay",
          "intent": {}
        },
        {
          "label": "decay, final",
          "intent": {
            "restore": false
          }
        },
        {
          "label": "decay, restored exempt",
          "intent": {
            "burst_exempt": [
              "restored"
            ]
          }
        },
        {
          "label": "decay, clock restarts",
          "intent": {
