{
  "name": "settings-coldstart",
  "title": "How long capacity takes to arrive",
  "question": "What does a slower coldstart cost on each kind of day — an on-premise executor that starts in no time or in five minutes, a cloud executor that starts in one minute or in ten?",
  "build": {
    "simlab-api": "v3.0.0"
  },
  "mine": {
    "id": "workday",
    "name": "Workday mine",
    "sensors": 30,
    "background_rate_per_hour": 91,
    "description": "Calibrated to an operational seismic-processing catalogue: 30 sensors and 91 events an hour give about 1,680 pick jobs an hour, against the 1,644 an hour that catalogue averages on a typical day."
  },
  "scenario": {
    "duration_seconds": 86400,
    "job_seconds": 28,
    "pick_jitter_seconds": 0.005,
    "priority_mix": {
      "100": 22.2,
      "50": 51.0,
      "0": 26.7
    },
    "description": "A day. Job mix and duration follow the operational catalogue: 22.2 % associate (priority 100), 51.0 % locate (50) and 26.7 % pick (0), and a weighted mean execution time of 28 s."
  },
  "run": {
    "decision_interval_seconds": 15
  },
  "settings": {
    "decision_interval_seconds": 15,
    "horizon_seconds": 900,
    "simulation_step_seconds": 15,
    "deadline_seconds_by_priority": {
      "400": 30,
      "100": 60,
      "50": 300,
      "25": 43200,
      "0": 86400
    },
    "default_deadline_seconds": 86400,
    "local_executor_cap": 12,
    "cloud_executor_cap": 60,
    "min_local_executors": 1,
    "local_coldstart_seconds": 60,
    "cloud_coldstart_seconds": 180,
    "scale_up_cooldown_seconds": 0,
    "max_scale_up_step": 50,
    "local_scale_down_window_seconds": 900,
    "cloud_scale_down_window_seconds": 300,
    "cloud_min_lifetime_seconds": 600,
    "safety_factor": 1.15,
    "dry_run": false
  },
  "intent": {
    "mode": "off",
    "knowledge": "estimate",
    "pre_location": false,
    "pre_location_magnitude": 1.5,
    "protect": [
      "person",
      "crewed-vehicle",
      "autonomous-vehicle"
    ],
    "lookahead_seconds": 300,
    "protect_level": "moderate",
    "promote_level": "high",
    "margin_m": 0,
    "location_uncertainty_m": 50,
    "decay_to": -1,
    "promote_to": 400,
    "deadline_from": "arrival",
    "restore": true,
    "burst_exempt": [
      "restored"
    ]
  },
  "seeds": [
    101,
    202,
    303,
    404
  ],
  "axes": [
    {
      "name": "day",
      "values": [
        {
          "label": "workday",
          "scenario": {
            "bursts": []
          }
        },
        {
          "label": "rock burst",
          "scenario": {
            "bursts": [
              {
                "at_seconds": 28800,
                "magnitude": 45,
                "aftershock_decay_seconds": 1800
              }
            ]
          }
        },
        {
          "label": "earthquake",
          "scenario": {
            "bursts": [
              {
                "at_seconds": 28800,
                "magnitude": 21,
                "aftershock_decay_seconds": 21600,
                "main_magnitude": 4.0
              }
            ]
          }
        }
      ]
    },
    {
      "name": "local coldstart",
      "values": [
        {
          "label": "local 0 s",
          "settings": {
            "local_coldstart_seconds": 0
          }
        },
        {
          "label": "local 1 min",
          "settings": {
            "local_coldstart_seconds": 60
          }
        },
        {
          "label": "local 5 min",
          "settings": {
            "local_coldstart_seconds": 300
          }
        }
      ]
    },
    {
      "name": "cloud coldstart",
      "values": [
        {
          "label": "cloud 1 min",
          "settings": {
            "cloud_coldstart_seconds": 60
          }
        },
        {
          "label": "cloud 3 min",
          "settings": {
            "cloud_coldstart_seconds": 180
          }
        },
        {
          "label": "cloud 10 min",
          "settings": {
            "cloud_coldstart_seconds": 600
          }
        }
      ]
    }
  ],
  "baseline": {
    "local coldstart": "local 1 min",
    "cloud coldstart": "cloud 3 min"
  },
  "columns": [
    "sla_breaches",
    "cloud_hours",
    "local_hours",
    "drained_hours",
    "overload_decisions",
    "p95_wait_s",
    "ttl_all_mean_s",
    "ttl_all_p95_s",
    "ttl_exposing_mean_s"
  ],
  "compare": [
    "sla_breaches",
    "cloud_hours",
    "local_hours",
    "p95_wait_s",
    "ttl_all_mean_s",
    "ttl_exposing_mean_s"
  ]
}
